{
  "name": "search-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "npx @opennextjs/cloudflare build",
    "cf:deploy": "npm run cf:build && npx @opennextjs/cloudflare deploy",
    "pages:build": "node scripts/pre-build.mjs && WRANGLER_BUILD_PLATFORM=node WRANGLER_BUILD_CONDITIONS= npm run cf:build && node scripts/patch-handler.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "crawler": "tsx --env-file=.env src/services/crawler.ts",
    "indexer": "tsx --env-file=.env src/services/indexer.ts",
    "ranker": "tsx --env-file=.env src/services/ranker.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.mts",
    "deploy:crawler": "npx wrangler deploy --config wrangler.crawler.toml"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@upstash/redis": "^1.31.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.31.0",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.17.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.12.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.22.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.16",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.95.0"
  }
}
