# Database (Neon serverless Postgres)
DATABASE_URL=postgres://user:pass@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis (Upstash serverless Redis)
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# App
NEXT_PUBLIC_APP_URL=https://m4vx-search.pages.dev
NEXT_PUBLIC_APP_NAME=M4vx Search

# Crawler
CRAWLER_USER_AGENT=SearchEngineBot/1.0
CRAWLER_DELAY_MS=1000
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES_PER_DOMAIN=10000
CRAWLER_CONCURRENCY=5
